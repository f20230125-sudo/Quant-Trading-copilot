# Copy to backend/.env and fill in. Never commit .env.
# The API key is optional: without it the copilot uses the built-in local analyst,
# and you can also connect Claude from the app.
ANTHROPIC_API_KEY=

# Model and effort used by the copilot. claude-sonnet-5 is cheaper if you want to save cost.
COPILOT_CLAUDE_MODEL=claude-opus-5
COPILOT_CLAUDE_EFFORT=medium

# Synthetic market: same seed + same start time => same price history.
COPILOT_MARKET_SEED=42
COPILOT_MARKET_HISTORY_SIZE=50000

# Origin allowed by CORS (the Next.js dev server).
COPILOT_FRONTEND_ORIGIN=http://localhost:3000

# Guardrails
COPILOT_CHAT_RATE_LIMIT_PER_MINUTE=10
COPILOT_MAX_AGENT_ITERATIONS=8
